---
layout: layouts/base.njk
hasCapture: true
hero:
  eyebrow: "For perimenopause, menopause and beyond"
  headline: "Real help for the changes no one warned you about"
  subheadline: "Hot flashes, restless nights, brain fog. MenoWellness sorts through what's out there and shares the options worth a closer look, in plain language."
  cta: "Find what helps"
  ctaHref: "#symptoms"
trust:
  - title: "Plain language"
    text: "No jargon, no scare tactics"
  - title: "Thoughtfully chosen"
    text: "Every pick has a reason"
  - title: "Always upfront"
    text: "Clear about how we earn"
  - title: "Made for midlife"
    text: "Written for women 40+"
---
<section class="hero">
  <div class="wrap">
    <p class="eyebrow">{{ hero.eyebrow }}</p>
    <h1>{{ hero.headline }}</h1>
    <p class="lede">{{ hero.subheadline }}</p>
    <a class="btn btn-large" href="{{ hero.ctaHref }}">{{ hero.cta }}</a>
  </div>
</section>

<section class="trust" aria-label="Why readers trust us">
  <div class="wrap">
    <ul>
      {% for item in trust %}
      <li><strong>{{ item.title }}</strong><span>{{ item.text }}</span></li>
      {% endfor %}
    </ul>
  </div>
</section>

<section class="section" id="offers" aria-labelledby="offers-title">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Our picks</p>
      <h2 id="offers-title">Featured favorites</h2>
      <p class="lede">Products worth a closer look, chosen for comfort, quality and value.</p>
    </div>
    {% set gridOffers = offers %}
    {% include "partials/offer-grid.njk" %}
  </div>
</section>

{% if symptoms.length %}
<section class="section section-alt" id="symptoms" aria-labelledby="symptoms-title">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Find what helps</p>
      <h2 id="symptoms-title">Browse by symptom</h2>
    </div>
    <ul class="symptom-nav">
      {% for symptom in symptoms %}
      <li><a href="/symptoms/{{ symptom.slug }}/">{{ symptom.name }}</a></li>
      {% endfor %}
    </ul>
  </div>
</section>
{% endif %}

{% include "partials/email-form.njk" %}
