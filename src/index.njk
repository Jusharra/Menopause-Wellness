---
layout: layouts/base.njk
hasCapture: true
# TODO: final hero copy
hero:
  eyebrow: "Perimenopause & menopause, made clearer"
  headline: "Feel more like yourself again"
  subheadline: "[Placeholder] Calm, plain-language guidance and hand-picked products for the changes midlife brings, from hot flashes to 3 a.m. wake-ups."
  cta: "Get the free guide"
  ctaHref: "#newsletter"
trust:
  - title: "Plain language"
    text: "No jargon, no scare tactics"
  - title: "Hand-picked"
    text: "Products chosen with care"
  - title: "Transparent"
    text: "Clear affiliate disclosure"
  - title: "Made for 40+"
    text: "Written for women in midlife"
---
<section class="hero">
  <div class="wrap">
    <p class="eyebrow">{{ hero.eyebrow }}</p>
    <h1>{{ hero.headline }}</h1>
    <p class="lede">{{ hero.subheadline }}</p>
    <a class="btn btn-large" href="{{ hero.ctaHref }}">{{ hero.cta }}</a>
  </div>
</section>

<section class="trust" aria-label="Why readers trust us">
  <div class="wrap">
    <ul>
      {% for item in trust %}
      <li><strong>{{ item.title }}</strong><span>{{ item.text }}</span></li>
      {% endfor %}
    </ul>
  </div>
</section>

<section class="section" id="offers" aria-labelledby="offers-title">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Our picks</p>
      <h2 id="offers-title">Featured favorites</h2>
      <p class="lede">[Placeholder] Products our readers come back to, chosen for comfort, quality and value.</p>
    </div>
    {% set gridOffers = offers %}
    {% include "partials/offer-grid.njk" %}
  </div>
</section>

{% if symptoms.length %}
<section class="section section-alt" id="symptoms" aria-labelledby="symptoms-title">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Find what helps</p>
      <h2 id="symptoms-title">Browse by symptom</h2>
    </div>
    <ul class="symptom-nav">
      {% for symptom in symptoms %}
      <li><a href="/symptoms/{{ symptom.slug }}/">{{ symptom.name }}</a></li>
      {% endfor %}
    </ul>
  </div>
</section>
{% endif %}

{% include "partials/email-form.njk" %}
