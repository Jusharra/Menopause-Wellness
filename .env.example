# Copy to .env for local development. NEVER commit the real .env file.
# In production, set these in Netlify: Site configuration > Environment variables.

# Airtable Personal Access Token (scopes: data.records:read, data.records:write, schema.bases:read)
AIRTABLE_API_KEY=
# Airtable base ID (not a secret, but kept in env so it can differ per environment)
AIRTABLE_BASE_ID=appPIg51oYqortKZJ

# Password for /admin/
ADMIN_PASSWORD=
# Random string, at least 32 characters, used to sign the admin session cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Netlify Build Hook URL (Site configuration > Build & deploy > Build hooks)
NETLIFY_BUILD_HOOK_URL=
